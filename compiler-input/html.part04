x="41" ry="30" fill="#759048"/>
                    <ellipse cx="344" cy="190" rx="38" ry="28" fill="#D06D3D"/>
                    <ellipse cx="375" cy="239" rx="29" ry="24" fill="#D6AA42"/>
                    <ellipse cx="309" cy="257" rx="48" ry="27" fill="#9FB967"/>
                    <circle cx="242" cy="247" r="17" fill="#B94832"/>
                    <path d="M221 157c34-36 73-36 94-4-39-4-60 6-94 4Z" fill="#46682F"/>
                    <path d="M324 147c34-28 73-18 84 19-34-15-60-15-84-19Z" fill="#5E7C3B"/>
                  </g>
                  <rect x="55" y="286" width="174" height="62" rx="18" fill="#B98E60" transform="rotate(-8 55 286)"/>
                  <path d="M55 90c38 30 72 43 120 45" fill="none" stroke="#6C7849" stroke-width="5" stroke-linecap="round"/>
                  <g fill="#7F8C58">
                    <ellipse cx="91" cy="101" rx="21" ry="7" transform="rotate(28 91 101)"/>
                    <ellipse cx="126" cy="122" rx="20" ry="7" transform="rotate(-26 126 122)"/>
                    <ellipse cx="161" cy="132" rx="20" ry="7" transform="rotate(26 161 132)"/>
