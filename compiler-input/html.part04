      <section class="screen screen-live" id="screen-live">
        <div class="live-shell">
          <div class="live-top">
            <div class="row between">
              <div><div class="live-head-title" id="liveBoardName" data-i18n="dinner">Dinner</div><div class="live-head-sub"><span id="liveBoardArea" data-i18n="stationHot">Hot station</span> · <span data-i18n="target">Target</span> <span id="liveBoardTime" data-time="18:30">18:30</span></div></div>
              <span class="badge" style="background:#3A3E36;color:white" data-i18n="live">Live</span>
            </div>
          </div>

          <div class="alert" id="liveWaitingAlert">
            <div class="alert-icon">⌛</div>
            <div class="grow"><strong id="waitingAlertTitle" data-i18n="taskRestChicken">Rest chicken</strong><small id="waitingAlertMeta"><span data-i18n="wait">Waiting</span> <span data-duration-minutes="2">2</span> · <span data-i18n="ready">Ready</span> <span data-time="18:05">18:05</span></small></div>
            <button class="attention-action" id="waitingAlertReview" data-review-task="chicken" data-i18n="review">Review</button>
          </div>

          <div class="targetbar">
            <div><div class="kicker" data-i18n="target">Target</div><div class="meta" id="liveTargetTime" data-time="18:30">18:30</div></div>
            <div style="text-align:center"><div class="bigtime" id="countdown" data-duration-seconds="1124">18:44</div></div>
            <button class="secondary" id="pauseAll" data-i18n="pause">Pause</button>
          </div>

          <div class="live-state-tabs" role="tablist" data-i18n-aria="live">
            <button class="active now" data-live-lane="now"><span data-i18n="now">Now</span><b data-lane-count="now">2</b></button>
            <button class="wait" data-live-lane="waiting"><span data-i18n="wait">Waiting</span><b data-lane-count="waiting">2</b>