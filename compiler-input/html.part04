              <circle cx="512" cy="76" r="22" fill="#6E8D43"/><circle cx="560" cy="74" r="22" fill="#C9693B"/><circle cx="586" cy="98" r="18" fill="#D6A73B"/>
            </svg>
          </div>
          <div class="feature-content">
            <div class="kicker" style="color:#CDD4C7"><span data-i18n="today">Today</span> · <span id="featureBoardArea" data-i18n="stationHot">Hot station</span></div>
            <h3 id="featureBoardName" data-i18n="dinner">Dinner</h3>
            <p><span aria-hidden="true">≡</span> <span id="featureBoardTaskCount" data-number="12">12</span> · <span aria-hidden="true">◷</span> <span id="featureBoardTime" data-time="18:30">18:30</span> · <span id="featureBoardProgress" data-percent="0.72">72%</span></p>
            <div class="feature-actions"><span class="badge olive" id="featureBoardStatus" data-i18n="onTrack">On track</span><button id="featureBoardOpen" data-board-open="demo-dinner" data-i18n="open">Open</button></div>
          </div>
        </div>

        <div class="boards-grid">
          <div>
            <div class="sectionhead"><div><h2 id="boardsListHeading" data-i18n="upcoming">Upcoming</h2></div></div>
            <div class="card list" id="boardsList">
              <div class="listrow" data-view="live"><div class="thumb"><svg viewBox="0 0 48 48"><rect width="48" height="48" fill="#E8DCC7"/><circle cx="18" cy="21" r="8" fill="#6F8A38"/><circle cx="30" cy="26" r="8" fill="#C75D35"/></svg></div><div class="grow"><b data-i18n="dinner">Dinner</b><div class="meta" data-i18n="stationHot">Hot station</div></div><div style="text-align:right"><b data-time="18:30">18:30</b><div class="meta" data-percent="0.72">72%</div></div></div>
              <div class="listrow"><div class="thumb"><svg viewBox="0 0 48 48"><rect width="48" height="48" fill="#E5E1DA"/><rect x="10" y="16" width="28" height="14" rx="5" fill="#C7B89C"/></svg></div><div class="grow"><b data-i18n="lateNight">Late night</b><div class="meta" data-i18n="stationSandwich">Sandwich</div></div><div style="text-align:right"><b data-time="22:30">22:30</b><div class="meta" data-percent="0">0%</div></div></div>
              <div class="listrow"><div class="thumb"><svg viewBox="0 0 48 48"><rect width="48" height="48" fill="#EEE7D9"/><circle cx="24" cy="24" r="12" fill="#DDD2BD"/></svg></div><div class="grow"><b data-i18n="lunch">Lunch</b><div class="meta"><span data-i18n="tomorrow">Tomorrow</span> · <span data-i18n="stationHot">Hot station</span></div></div><div style="text-align:right"><b data-time="11:30">11:30</b><div class="meta" data-percent="0">0%</div></div></div>
            </div>
          </div>

          <div>
            <div class="sectionhead"><div><h2 data-i18n="template">Template</h2></div></div>
            <div class="card list">
              <div class="listrow"><div class="grow"><b data-i18n="dinner">Dinner</b><div class="meta"><span data-i18n="stationHot">Hot station</span> · <span data-number="18">18</span></div></div><span>›</span></div>
              <div class="listrow"><div class="grow"><b data-i18n="brunch">Brunch</b><div class="meta"><span data-i18n="stationPastry">Pastry</span> · <span data-number="14">14</span></div></div><span>›</span></div>
              <div class="listrow"><div class="grow"><b data-i18n="banquet">Banquet</b><div class="meta"><span data-i18n="stationBanquet">Banquet</span> · <span data-number="22">22</span></div></div><span>›</span></div>
            </div>
          </div>
