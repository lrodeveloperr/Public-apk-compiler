function normalizeLocale(raw){
  const v=(raw||"en").replace("_","-");
  if(I18N[v])return v;
  const low=v.toLowerCase();
  if(low.startsWith("zh-tw")||low.startsWith("zh-hk")||low.startsWith("zh-hant"))return "zh-Hant";
  if(low.startsWith("zh"))return "zh-Hans";
  if(low.startsWith("nb")||low.startsWith("no"))return "nb";
  if(low.startsWith("fil")||low.startsWith("tl"))return "fil";
  const base=v.split("-")[0];
  return I18N[base]?base:"en";
}
let uiLocale=normalizeLocale(localStorage.getItem("kpb-ui-locale")||navigator.language||"en");

function nf(code,opts={}){return new Intl.NumberFormat(code,opts)}
function formatClock(code,value){
  const [h,m]=value.split(":").map(Number);
  const d=new Date(2000,0,1,h,m,0,0);
  return new Intl.DateTimeFormat(code,{hour:"numeric",minute:"2-digit"}).format(d);
}
function formatMinutes(code,total){
  const hours=Math.floor(Number(total)/60),mins=Number(total)%60;
  const parts=[];
  if(hours)parts.push(new Intl.NumberFormat(code,{style:"unit",unit:"hour",unitDisplay:"narrow"}).format(hours));
  if(mins||!hours)parts.push(new Intl.NumberFormat(code,{style:"unit",unit:"minute",unitDisplay:"narrow"}).format(mins));
  return parts.join(" ");
}
function formatCountdown(code,totalSeconds){
  const m=Math.floor(Number(totalSeconds)/60),s=Number(totalSeconds)%60;
  const two=new Intl.NumberFormat(code,{minimumIntegerDigits:2,useGrouping:false});
  return `${two.format(m)}:${two.format(s)}`;
}
function applyLocaleFormatting(code){
  document.querySelectorAll("[data-time]").forEach(el=>el.textContent=formatClock(code,el.dataset.time));
  document.querySelectorAll("[data-number]").forEach(el=>el.textContent=nf(code).format(Number(el.dataset.number)));
  document.querySelectorAll("[data-number-decimal]").forEach(el=>el.textContent=nf(code,{maximumFractionDigits:1}).format(Number(el.dataset.numberDecimal)));
  document.querySelectorAll("[data-percent]").forEach(el=>el.textContent=nf(code,{style:"percent",maximumFractionDigits:0}).format(Number(el.dataset.percent)));
  document.querySelectorAll("[data-duration-minutes]").forEach(el=>el.textContent=formatMinutes(code,Number(el.dataset.durationMinutes)));
  document.querySelectorAll("[data-duration-seconds]").forEach(el=>el.textContent=formatCountdown(code,Number(el.dataset.durationSeconds)));
}

function applyLocale(code){
  code=normalizeLocale(code);
  uiLocale=code;
  const pack=I18N[code];
  document.documentElement.lang=code;
  document.documentElement.dir=pack.dir;
  document.body.dir=pack.dir;
  document.querySelectorAll("[data-i18n]").forEach(el=>{
    const k=el.dataset.i18n;
    if(!(k in pack.s))throw new Error(`Missing ${code}.${k}`);
    el.textContent=pack.s[k];
  });
  document.querySelectorAll("[data-i18n-aria]").forEach(el=>{
    const k=el.dataset.i18nAria;
    if(!(k in pack.s))throw new Error(`Missing ${code}.${k}`);
    el.setAttribute("aria-label",pack.s[k]);
  });
  document.querySelectorAll("[data-i18n-placeholder]").forEach(el=>{
    const k=el.dataset.i18nPlaceholder;
    if(!(k in pack.s))throw new Error(`Missing ${code}.${k}`);
    el.setAttribute("placeholder",pack.s[k]);
  });
  applyLocaleFormatting(code);
  const sel=document.getElementById("languageSelect");
  if(sel)sel.value=code;
  const p=document.getElementById("pauseAll");
  if(p)p.textContent=paused?pack.s.resume:pack.s.pause;
  localStorage.setItem("kpb-ui-locale",code);
  if(typeof renderCreateStep==="function")renderCreateStep();
  const dt=document.getElementById("doneToggle");
  if(dt&&doneItems)dt.textContent=doneItems.hasAttribute("hidden")?pack.s.show:pack.s.hide;
  const activeScreen=document.querySelector(".screen.active");
  updateTopTitle(activeScreen?activeScreen.id.replace("screen-",""):"home");
  if(typeof renderBoardsView==="function")renderBoardsView();
  if(typeof renderActiveBoardContext==="function")renderActiveBoardContext();
}
function buildLanguageMenu(){
  const sel=document.getElementById("languageSelect");
  if(!sel)return;
  sel.innerHTML="";
  Object.entries(I18N).forEach(([code,pack])=>{
    const o=document.createElement("option");
    o.value=code;o.textContent=pack.name;sel.appendChild(o);
  });
  sel.value=uiLocale;
  sel.addEventListener("change",()=>applyLocale(sel.value));
}

const titles={home:"Kitchen Prep Board",boards:"Boards",create:"New",live:"Live",settings:"Settings"};
function updateTopTitle(v){
  const t=document.getElementById("topTitle");
  if(!t)return;
  if(v==="home"){t.textContent="Kitchen Prep Board";return}
  const key=({boards:"boards",create:"new",live:"live",settings:"settings"})[v];
  if(key)t.textContent=I18N[uiLocale].s[key];
}
function setView(v){
  document.querySelectorAll(".screen").forEach(x=>x.classList.remove("active"));
  const s=document.getElementById("screen-"+v);
  if(s)s.classList.add("active");
  document.querySelectorAll("[data-view]").forEach(x=>{
    const nav=x.closest(".bottomnav")||x.closest(".railnav");
    if(nav)x.classList.toggle("active",x.dataset.view===v);
  });
  updateTopTitle(v);
  window.scrollTo({top:0,behavior:"smooth"});
  if(typeof window.kpbOnViewChange==="function")window.kpbOnViewChange(v);
}
document.addEventListener("click",e=>{
  const v=e.target.closest("[data-view]");
  if(v){
    if(v.dataset.view==="create"&&typeof prepareNewBoardDraft==="function")prepareNewBoardDraft();
    setView(v.dataset.view);return;
  }
  const sw=e.target.closest(".switch");
  if(sw)sw.classList.toggle("on");
});

document.getElementById("addTask").onclick=()=>{
  const list=document.getElementById("taskList");
  const d=document.createElement("div");
  d.className="task-card";
  d.innerHTML='<span class="drag">⠿</span><div class="thumb"><svg viewBox="0 0 48 48"><rect width="48" height="48" fill="#E7E2D9"/><circle cx="24" cy="24" r="10" fill="#89916A"/></svg></div><div class="grow"><div class="task-name" data-i18n="newTask"></div><div class="task-meta" data-i18n="edit"></div></div><span class="badge" data-duration-minutes="10">10</span>';
  list.appendChild(d);
  applyLocale(uiLocale);
};
document.querySelectorAll("#timingSeg button").forEach(b=>b.onclick=()=>{
  document.querySelectorAll("#timingSeg button").forEach(x=>x.classList.remove("active"));
  b.classList.add("active");
});

const BOARDS_KEY="kpb-boards-v1";
const VALID_BOARD_STATUS=new Set(["upcoming","active","completed"]);

function kpbId(prefix="kpb"){
  try{return `${prefix}-${crypto.randomUUID()}`}catch(_){return `${prefix}-${Date.now()}-${Math.random().toString(36).slice(2)}`}
}
function cloneTasks(tasks){return tasks.map(t=>({...t}))}
const DEMO_DINNER_TASKS=[
  {id:"roast",nameKey:"taskRoastVeg",durationSeconds:501,durationMinutes:10,initialLane:"now"},
  {id:"dressing",nameKey:"taskHerbDressing",durationSeconds:252,durationMinutes:5,initialLane:"now"},
  {id:"chicken",nameKey:"taskRestChicken",durationSeconds:123,durationMinutes:15,initialLane:"waiting",waitAction:"check"},
  {id:"plates",nameKey:"taskWarmPlates",durationSeconds:300,durationMinutes:10,initialLane:"waiting"},
  {id:"proteins",nameKey:"taskPortionProteins",durationMinutes:10,initialLane:"next"},
  {id:"garnish",nameKey:"taskPrepGarnishes",durationMinutes:8,initialLane:"next"},
  {id:"greens",nameKey:"taskWashGreens",durationMinutes:5,initialLane:"done"},
  {id:"sanitize",nameKey:"taskSanitize",durationMinutes:5,initialLane:"done"}
];
function seedBoards(){
  const now=Date.now();
  return [
    {id:"demo-dinner",nameKey:"dinner",areaKey:"stationHot",time:"18:30",notes:"",timingMode:"target",status:"active",createdAt:now-7200000,initialRemainingSeconds:1124,tasks:cloneTasks(DEMO_DINNER_TASKS)},
    {id:"demo-late-night",nameKey:"lateNight",areaKey:"stationSandwich",time:"22:30",notes:"",timingMode:"target",status:"upcoming",createdAt:now-3600000,tasks:cloneTasks(DEMO_DINNER_TASKS.slice(0,5)).map((t,i)=>({...t,id:`late-${i}`,initialLane:i<2?"now":"next"}))},
    {id:"demo-lunch",nameKey:"lunch",areaKey:"stationHot",time:"11:30",notes:"",timingMode:"target",status:"upcoming",createdAt:now-1800000,tasks:cloneTasks(DEMO_DINNER_TASKS.slice(0,4)).map((t,i)=>({...t,id:`lunch-${i}`,initialLane:i<2?"now":"next",waitAction:undefined}))},
    {id:"demo-brunch",nameKey:"brunch",areaKey:"stationPastry",time:"10:30",notes:"",timingMode:"target",status:"completed",createdAt:now-172800000,tasks:cloneTasks(DEMO_DINNER_TASKS.slice(0,4)).map((t,i)=>({...t,id:`brunch-${i}`,initialLane:"done",waitAction:undefined}))},
    {id:"demo-banquet",nameKey:"banquet",areaKey:"stationBanquet",time:"19:00",notes:"",timingMode:"target",status:"completed",createdAt:now-259200000,tasks:cloneTasks(DEMO_DINNER_TASKS.slice(0,6)